#!/bin/sh
# KubeOS kernel flavour meta, postinst: guarantee an initramfs exists for every installed kernel.
#
# WHY    Nothing else does it reliably in a build chroot, and the two ways people assume it
#        happens both silently do nothing:
#          1. `update-initramfs -u` UPDATES ONLY an initrd that already exists - its version
#             list is built by get_sorted_versions(), which keeps a version only when
#             "${BOOTDIR}/initrd.img-$version" is present (read from
#             /usr/sbin/update-initramfs.orig.initramfs-tools on trixie). On a fresh chroot
#             that list is empty, so `-u -k all` exits 0 having generated nothing.
#             Measured 2026-11-22: linux-image-kubeos 6.12.117-1kubeos2's postinst ran
#             `update-initramfs -u -k all`, reported success, and /boot stayed without any
#             initrd.img-*, so live-build's binary_syslinux failed the build with
#             "ls: cannot access 'binary/live/initrd.img-*': No such file or directory".
#          2. The KubeOS kernel deb is built with `make deb-pkg` and declares NO Depends, so
#             dpkg may configure it before initramfs-tools, and then its own postinst runs
#             with no working /etc/kernel/postinst.d hook and builds nothing.
#        Creating one is `-c`. This script therefore uses `-c` for a kernel that has no initrd
#        and `-u` for one that has (the same choice Debian's kernel hooks make), for every
#        version `linux-version list` reports.
# SAFE   Idempotent, and WARN-ONLY: a failed initramfs build must never abort a package
#        install - the rest of the node is fine, and `update-initramfs -c -k all` fixes it.
set -e

# debhelper inserts its generated snippets here (systemd enable/reload, dpkg-maintscript
# helpers). It must sit before this script's own exits, otherwise they never run - that is
# exactly how every KubeOS package once ended up with units debhelper never enabled.
#DEBHELPER#

warn() { printf 'kubeos-kernel: WARNING: %s\n' "$*" >&2; }
log() { printf 'kubeos-kernel: %s\n' "$*"; }

case "${1:-}" in
    configure|abort-upgrade|abort-remove|abort-deconfigure) : ;;
    *) exit 0 ;;
esac

if [ ! -x /usr/sbin/update-initramfs ]; then
    warn "update-initramfs is not installed; no initramfs was built"
    exit 0
fi

if [ -x /usr/bin/linux-version ]; then
    versions=$(linux-version list 2>/dev/null) || versions=""
else
    # linux-base missing (it is a Depends, so this is only a safety net): let
    # initramfs-tools pick the kernels itself.
    versions=""
fi

built=0
failed=0

if [ -z "$versions" ]; then
    if update-initramfs -c -k all; then
        built=1
    else
        failed=1
        warn "update-initramfs -c -k all failed; run it by hand before rebooting"
    fi
else
    for kernel in $versions; do
        if [ ! -r "/boot/vmlinuz-$kernel" ]; then
            continue
        fi
        if [ -e "/boot/initrd.img-$kernel" ]; then
            update-initramfs -u -k "$kernel" || { failed=1; warn "update-initramfs -u -k $kernel failed"; }
        else
            update-initramfs -c -k "$kernel" || { failed=1; warn "update-initramfs -c -k $kernel failed"; }
        fi
    done
fi

for initrd in /boot/initrd.img-*; do
    if [ -f "$initrd" ]; then
        log "initramfs present: $initrd"
        built=1
    fi
done

if [ "$built" = 0 ]; then
    warn "no /boot/initrd.img-* exists after this install; the node will not boot this kernel"
elif [ "$failed" = 1 ]; then
    warn "an initramfs update failed; re-run 'update-initramfs -c -k all' before rebooting"
fi

exit 0
